# Нормализация переводов строк
* text=auto eol=lf

# Бинарники без diff
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.apk binary
*.aab binary
*.jar binary
*.keystore binary

# Явный LF для исходников
*.py text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.sh text eol=lf

# Windows scripts — CRLF допустим
*.bat text eol=crlf
*.ps1 text eol=crlf
