# Saylat Proxy — скопируйте в .env на VPS
# Префикс: SAYLAT_

SAYLAT_HOST=0.0.0.0
SAYLAT_PORT=8787

# Playwright — скриншот-полосы (/api/render/strips?engine=browser)
SAYLAT_PLAYWRIGHT_ENABLED=true
SAYLAT_PLAYWRIGHT_TIMEOUT_SEC=35
SAYLAT_PLAYWRIGHT_MAX_CONCURRENT=2
SAYLAT_APP_VERSION_CODE=18
SAYLAT_APP_VERSION_NAME=0.5.7

# Telegram (my.telegram.org → API development tools)
SAYLAT_TELEGRAM_API_ID=0
SAYLAT_TELEGRAM_API_HASH=
SAYLAT_TELEGRAM_SESSION_PATH=./data/telegram

# Почта
SAYLAT_MAIL_IMAP_HOST=imap.example.com
SAYLAT_MAIL_IMAP_PORT=993
SAYLAT_MAIL_SMTP_HOST=smtp.example.com
SAYLAT_MAIL_SMTP_PORT=587
SAYLAT_MAIL_USERNAME=user@example.com
SAYLAT_MAIL_PASSWORD=
SAYLAT_MAIL_USE_SSL=true

# VK (https://dev.vk.com — token с правами wall, offline)
SAYLAT_VK_ACCESS_TOKEN=

# Дзен: Cookie из браузера после входа (один раз при Wi‑Fi)
SAYLAT_DZEN_SESSION_COOKIE=
